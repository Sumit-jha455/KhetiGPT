.env
.env.*
!.env.example

# Log files created by npm and package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editor and operating system specific files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite / TypeScript cache folders
.cache/
.vite/
*.tsbuildinfo
